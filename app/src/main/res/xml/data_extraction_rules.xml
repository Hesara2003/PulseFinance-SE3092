<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 and newer (android:dataExtractionRules). allowBackup="false" no longer stops
    device-to-device transfer there, so the finance cache (Room), preferences and files are
    excluded from both cloud backup and device transfer. Firestore restores his records when
    he signs in on the new phone (#96).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
